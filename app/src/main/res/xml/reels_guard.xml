<?xml version="1.0" encoding="utf-8"?>
<!-- Scroll events from YouTube and Instagram only. It reads the names (resource IDs) of the view that
     scrolled and the views around it, to tell a swipe through Shorts or Reels from anything else.
     It never reads text. flagRetrieveInteractiveWindows: older Android versions otherwise only let it
     look at the "active" window, which can lag a moment behind the app you're swiping in. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/reels_description"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.youtube,app.revanced.android.youtube,com.instagram.android" />
